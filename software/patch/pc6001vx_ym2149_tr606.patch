--- a/src/synchub_bridge.h
+++ b/src/synchub_bridge.h
@@ -0,0 +1,54 @@
+#ifndef SYNCHUB_BRIDGE_H
+#define SYNCHUB_BRIDGE_H
+
+#include <fcntl.h>
+#include <unistd.h>
+#include <termios.h>
+#include <stdint.h>
+
+class SyncHubBridge {
+private:
+    int fd;
+public:
+    SyncHubBridge() : fd(-1) {
+        fd = open("/dev/ttyU0", O_WRONLY | O_NOCTTY | O_NONBLOCK);
+        if (fd >= 0) {
+            struct termios tty;
+            if (tcgetattr(fd, &tty) == 0) {
+                cfmakeraw(&tty);
+                cfsetospeed(&tty, B115200);
+                tcsetattr(fd, TCSANOW, &tty);
+            }
+        }
+    }
+    ~SyncHubBridge() {
+        if (fd >= 0) {
+            sendPsg(7, 0x3F);
+            sendPsg(8, 0);
+            sendPsg(9, 0);
+            sendPsg(10, 0);
+            sendSync(0);
+            close(fd);
+        }
+    }
+    void sendPsg(uint8_t reg, uint8_t val) {
+        if (fd >= 0) {
+            uint8_t pkt[3] = { 0xAA, (uint8_t)(reg & 0x0F), val };
+            write(fd, pkt, 3);
+        }
+    }
+    void sendSync(uint8_t run) {
+        if (fd >= 0) {
+            uint8_t pkt[2] = { 0xBB, run };
+            write(fd, pkt, 2);
+        }
+    }
+};
+
+#endif
